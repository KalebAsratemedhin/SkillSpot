# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Local docker compose sets DATABASE_URL / REDIS_URL to the db and redis services.
# For production (or docker run), set these yourself:
# DATABASE_URL=postgres://user:pass@host:5432/skillspot
# REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
# DB_CONN_MAX_AGE=0   # keep 0 on Neon/Render; optional 600 against stable local Postgres

POSTGRES_DB=skillspot
POSTGRES_USER=skillspot
POSTGRES_PASSWORD=skillspot

# Optional Celery
# CELERY_CONCURRENCY=1

# Optional admin on first boot (email is the username field)
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_key_here
STRIPE_PLATFORM_FEE_PERCENT=5.0

# Frontend URL
FRONTEND_URL=http://localhost:5173
